# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_DB_PASSWORD=your_database_password_here

# CORS Configuration
# For development (allow all origins)
CORS_ORIGINS=*
# For production (specify allowed domains)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000

# Outfit Generation Configuration
SHOPPING_RESULTS_TO_RETURN=10
NUM_OUTFITS_IN_GRID=3
NUM_ITEMS_PER_OUTFIT=4
QUEUE_MULTIPLIER=2

# Shopping Configuration  
SHOPPING_MIN_PRICE=40
SHOPPING_MAX_PRICE=200
# Number of results to fetch from Serper for each item
SHOPPING_RESULTS_TO_FETCH=40
# Number of results to feed into ranking before cutting down to SHOPPING_RESULTS_TO_RETURN
SHOPPING_RESULTS_TO_RANK=20

# Product Ranking
# Set to false to skip AI-based product ranking and return results in original order
PRODUCT_RANKING_ENABLED=true

# Background Removal (now only applies to top ranked product)
# Set to false to disable background removal processing for faster responses
BACKGROUND_REMOVAL_ENABLED=true
# Concurrency for download/upload + scheduling (default: 2x CPU cores)
BACKGROUND_REMOVAL_MAX_CONCURRENCY=8
# Number of process workers for CPU-bound removal (default: min(4, CPU cores))
BACKGROUND_REMOVAL_PROCESS_WORKERS=2
# Max width/height of image before removal (downscales larger images)
BACKGROUND_REMOVAL_MAX_DIM=1024

# Performance Optimization Settings
# Maximum concurrent search requests to Serper API (higher = faster parallel searches)
SERPER_MAX_CONCURRENCY=25
# Maximum concurrent ranking operations (higher = faster ranking but more OpenAI API usage)
RANKING_BATCH_SIZE=12
# Virtual try-on timeout in seconds (prevents hanging operations)
VIRTUAL_TRYON_TIMEOUT=100
VTON_ENABLED=true
# Toggle face swapping during virtual try-on; set to false to skip swapping and heavy model preload
FACE_SWAP_ENABLED=true

# OpenAI Client Timeout Settings (in seconds)
# Connection timeout - time to wait for initial connection to OpenAI API
OPENAI_CONNECT_TIMEOUT=10.0
# Read timeout - time to wait for response data (important for streaming, set higher for long responses)
OPENAI_READ_TIMEOUT=300.0
# Write timeout - time to wait when sending request data
OPENAI_WRITE_TIMEOUT=60.0
# Pool timeout - time to wait for connection from pool
OPENAI_POOL_TIMEOUT=60.0


# Prompt Logging
# Set to true to enable logging of outfit generation, ranking, and virtual try-on prompts
# Each prompt type logs only once per session/process (outfit=every time, ranking/vton=first time only)
ENABLE_PROMPT_LOGGING=false



# Search Source Filtering
# Comma-separated list of sources to block from search results
BLOCKED_SOURCES=ebay,aliexpress,dhgate,wish,temu,alibaba,banggood,gearbest

# Search Providers
# Choose which search provider to use: "serper" (default) or "serpapi"
SEARCH_PROVIDER=serper
# API keys for each provider (set the one you're using)
SERPER_API_KEY=
SERPAPI_API_KEY=

# Face Swap Quality Configuration
# ========================================
# QUALITY vs SPEED TRADEOFFS:
# - Higher detection size = better face detection but ~2-4x slower
# - Lower detection threshold = more faces detected but may include false positives
# ========================================

# Higher detection resolution = better face detection but slower (default: 320, recommended: 640-1024)
FACE_DETECTION_SIZE=640
# Lower detection threshold = more sensitive face detection (default: 0.1, range: 0.05-0.5)
FACE_DETECTION_THRESHOLD=0.05
# Minimum face size for quality filtering (pixels, default: 1024 = 32x32)
FACE_MIN_SIZE=1024
# Minimum face detection confidence for quality filtering (0.0-1.0, default: 0.5)
FACE_MIN_CONFIDENCE=0.5

# InsightFace Model Storage
# ========================================
# Path where InsightFace models are stored (for persistent volume on Railway)
# Local development: uses ~/.insightface by default
# Railway deployment: set to /data/insight_cache (requires persistent volume)
INSIGHTFACE_HOME=~/.insightface
