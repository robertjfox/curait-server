#!/usr/bin/env python3

import requests
import sys

def main():
    gender = "male"
    
    url = "http://localhost:8000/api/explore-ideas/generate-ideas"
    params = {"gender": gender}
    
    print(f"Generating explore ideas for {gender}...")
    
    try:
        response = requests.post(url, params=params, timeout=120)
        response.raise_for_status()
        result = response.json()
        print(f"Success! Generated {result.get('created', 0)} ideas")
    except Exception as e:
        print(f"Error: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()
