#!/usr/bin/env python3

import requests
import sys
import argparse

def main():
    parser = argparse.ArgumentParser(description="Generate a single explore idea from a trend outfit")
    parser.add_argument("--host", default="localhost:8000", help="Server host (default: localhost:8000)")
    
    args = parser.parse_args()
    
    # Hardcoded trend outfit ID
    trend_outfit_id = 'f1ec133a-022e-44cc-8f7b-a9635e8ec538'
    
    url = f"http://{args.host}/api/explore-ideas/generate-ideas"
    params = {"trend_outfit_id": trend_outfit_id}
    
    print("\n\n--------------------------------\n\n")
    print(f"🔍 Generating explore idea from trend outfit {trend_outfit_id}...")
    
    try:
        response = requests.post(url, params=params, timeout=60)
        response.raise_for_status()
        result = response.json()
        
        if result.get("success") and result.get("created", 0) > 0:
            idea = result["rows"][0]
            print(f"✅ Success! Created explore idea:")
            print(f"   Title: {idea.get('title', 'N/A')}")
            print(f"   Description: {idea.get('description', 'N/A')}")
            print(f"   ID: {idea.get('id', 'N/A')}")
            if idea.get('image_url'):
                print(f"   Image: {idea['image_url']}")
        elif result.get("created", 0) == 0:
            print("ℹ️  Could not generate explore idea (trend outfit may not exist or have no items)")
        else:
            print(f"❌ Request failed: {result}")
            sys.exit(1)
            
    except requests.exceptions.RequestException as e:
        print(f"❌ Network error: {e}")
        sys.exit(1)
    except Exception as e:
        print(f"❌ Error: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()
