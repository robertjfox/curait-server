#!/usr/bin/env python3

"""Utility script to trigger trend outfit variation generation for the most recent
explore ideas that currently have exactly one linked trend outfit."""

import argparse
import sys
import os
import time
from typing import List, Tuple, Dict, Any
import requests

# Add the project root to Python path
script_dir = os.path.dirname(os.path.abspath(__file__))
project_root = os.path.dirname(script_dir)
sys.path.insert(0, project_root)

from clients.supabase_client import get_supabase_client


def find_latest_single_linked_explores(count: int = 9) -> List[Tuple[Dict[str, Any], Dict[str, Any]]]:
    """Return the most recent explore ideas with exactly one trend outfit."""
    supabase = get_supabase_client()

    try:
        ideas_resp = (
            supabase
            .table("explore_ideas")
            .select("id, title, created_at")
            .order("created_at", desc=False)
            .limit(200)
            .execute()
        )
    except Exception as exc:
        print(f"❌ Failed to fetch explore ideas: {exc}")
        return []

    explore_rows = ideas_resp.data or []
    found_explores = []

    for explore in explore_rows:
        if len(found_explores) >= count:
            break
            
        explore_id = explore.get("id")
        if not explore_id:
            continue

        try:
            outfits_resp = (
                supabase
                .table("trend_outfits")
                .select("id, created_at")
                .eq("explore_idea_id", explore_id)
                .order("created_at", desc=False)
                .execute()
            )
        except Exception as exc:
            print(f"⚠️  Failed to fetch trend outfits for explore {explore_id}: {exc}")
            continue

        outfits = outfits_resp.data or []
        if len(outfits) == 1:
            found_explores.append((explore, outfits[0]))

    return found_explores


def trigger_variation(host: str, trend_outfit_id: str, title: str) -> bool:
    """Trigger variation generation and return True if successful."""
    url = f"http://{host}/api/explore-ideas/trend-outfit-variation"
    params = {"trend_outfit_id": trend_outfit_id}

    print(f"  🔄 Processing: {title} (outfit {trend_outfit_id})")
    
    try:
        response = requests.post(url, params=params, timeout=120)
        response.raise_for_status()
        result = response.json()
        
        if result.get("success"):
            created = result.get("created", 0)
            print(f"    ✅ Created {created} new trend outfit variation(s)")
            return True
        else:
            print(f"    ❌ Request failed: {result}")
            return False
            
    except Exception as exc:
        print(f"    ❌ Request failed: {exc}")
        return False


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Generate additional trend outfit variations for the most recent explore ideas linked to a single outfit"
    )
    parser.add_argument("--host", default="localhost:8000", help="Server host (default: localhost:8000)")
    args = parser.parse_args()

    explore_pairs = find_latest_single_linked_explores(count=9)

    if not explore_pairs:
        print("ℹ️  No explore ideas found with exactly one linked trend outfit.")
        sys.exit(0)

    print(f"\n🔍 Found {len(explore_pairs)} explore idea(s) with single trend outfits")
    print("🚀 Processing sequentially...")
    
    success_count = 0
    for i, (explore, trend_outfit) in enumerate(explore_pairs, 1):
        title = explore.get("title", "(untitled)")
        trend_outfit_id = trend_outfit["id"]
        
        print(f"\n[{i}/{len(explore_pairs)}]")
        if trigger_variation(args.host, trend_outfit_id, title):
            success_count += 1
        
        # Small delay between requests
        if i < len(explore_pairs):
            time.sleep(1)

    print(f"\n🎉 Completed! {success_count}/{len(explore_pairs)} successful variations generated")


if __name__ == "__main__":
    main()
